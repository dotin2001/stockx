APP_ENVIRONMENT=production
DATABASE_URL=
# Bounds PostgreSQL connection establishment used by GET /ready.
DATABASE_CONNECT_TIMEOUT_SECONDS=2
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
REFRESH_COOKIE_NAME=stockx_refresh
REFRESH_COOKIE_SECURE=true
REFRESH_COOKIE_HTTPONLY=true
REFRESH_COOKIE_SAMESITE=lax
CORS_ORIGINS=https://shop.example.com
CHECKOUT_MODE=disabled
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
FRONTEND_BASE_URL=https://shop.example.com
STRIPE_EXPECTED_LIVEMODE=false
STRIPE_RESERVATION_MINUTES=30
STRIPE_USE_FAKE_PROVIDER=false
AUTH_RATE_LIMIT_BACKEND=redis
AUTH_RATE_LIMIT_REDIS_URL=
AUTH_RATE_LIMIT_WINDOW_SECONDS=300
AUTH_RATE_LIMIT_REGISTER=20
AUTH_RATE_LIMIT_LOGIN=30
AUTH_RATE_LIMIT_REFRESH=60
AUTH_RATE_LIMIT_VERIFICATION=10
AUTH_RATE_LIMIT_PASSWORD_RESET=10
AUTH_RATE_LIMIT_FAIL_CLOSED=true
TRUSTED_PROXY_ADDRESSES=
ACTION_DELIVERY_BACKEND=webhook
ACTION_DELIVERY_WEBHOOK_URL=
VERIFICATION_TOKEN_EXPIRE_MINUTES=60
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
ERROR_REPORTER_BACKEND=disabled
# Required only when ERROR_REPORTER_BACKEND=webhook; must be absolute HTTPS.
ERROR_REPORTER_WEBHOOK_URL=
# Reporter failures never delay the sanitized API response beyond this bound (max 2).
ERROR_REPORTER_TIMEOUT_SECONDS=1
