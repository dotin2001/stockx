AUTH_RATE_LIMIT_REGISTER=1000
AUTH_RATE_LIMIT_LOGIN=1000
AUTH_RATE_LIMIT_REFRESH=1000
AUTH_RATE_LIMIT_VERIFICATION=1000
AUTH_RATE_LIMIT_PASSWORD_RESET=1000
