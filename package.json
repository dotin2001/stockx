{
  "name": "stockx-marketplace",
  "private": true,
  "bin": {
    "lazy": "./bin/lazy.mjs",
    "ai-local": "./bin/ai-local.mjs"
  },
  "engines": {
    "node": ">=18.18.0"
  },
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mjs tests/ai-local/*.test.mjs",
    "ai:local": "node ./bin/ai-local.mjs",
    "ai:local:test": "node --test tests/ai-local/*.test.mjs",
    "lazy:test": "node --test tests/lazy-cli.test.mjs",
    "web:smoke:admin-products": "node --test tests/admin-product-create-form.test.mjs",
    "web:smoke:store-flow": "node --test tests/store-flow-source.test.mjs",
    "web:smoke:checkout-orders": "node --test tests/checkout-order-source.test.mjs",
    "web:dev": "npm run dev --workspace apps/web",
    "web:lint": "npm run lint --workspace apps/web",
    "web:build": "npm run build --workspace apps/web",
    "web:typecheck": "npm run typecheck --workspace apps/web"
  }
}
