{
  "name": "stockx-marketplace",
  "private": true,
  "bin": {
    "lazy": "./bin/lazy.mjs"
  },
  "engines": {
    "node": ">=18.18.0"
  },
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "lazy:test": "node --test tests/lazy-cli.test.mjs",
    "web:smoke:admin-products": "node --test tests/admin-product-create-form.test.mjs",
