{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "phase", "summary", "humanReviewRequired", "humanReviewReasons", "entries"],
  "properties": {
    "version": { "const": 1 },
    "phase": { "const": "review" },
    "summary": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "humanReviewRequired": { "type": "boolean" },
    "humanReviewReasons": {
      "type": "array",
      "maxItems": 10,
      "items": { "type": "string", "minLength": 1, "maxLength": 500 }
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "id", "label", "result", "evidence", "remainingWork"],
        "properties": {
          "source": { "enum": ["issue", "openspec", "task", "check"] },
          "id": { "type": "string", "pattern": "^[a-z]+:[a-z0-9][a-z0-9._:-]{0,119}$" },
          "label": { "type": "string", "minLength": 1, "maxLength": 500 },
          "result": { "enum": ["PASS", "FAIL", "BLOCKED"] },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "maxItems": 10,
            "items": { "type": "string", "minLength": 1, "maxLength": 500 }
          },
          "remainingWork": {
            "type": "array",
            "maxItems": 10,
            "items": { "type": "string", "minLength": 1, "maxLength": 500 }
          }
        }
      }
    }
  }
}
